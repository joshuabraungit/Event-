# Copy to .env.local. Every key is optional; the app runs in mock mode with none set.
# Secrets are only read on the server and never sent to the browser.

# Where the SQLite database lives (default: ./data/sponsor-signals.db)
# DATABASE_PATH=./data/sponsor-signals.db

# Optional: Claude for brand-candidate suggestions and evidence interpretation.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: Brave Search API for public articles, press and partnership announcements.
# https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# Optional: Meta Ad Library API (Graph API ads_archive). Needs identity verification
# and an app with Ad Library API access. Commercial ads are only returned where they
# were delivered in the EU/UK.
# META_AD_LIBRARY_ACCESS_TOKEN=
# META_GRAPH_API_VERSION=v24.0
# META_AD_REACHED_COUNTRIES=GB,DE,FR,IE,NL,ES,IT,SE

# Country the manual "check by hand" Meta Ad Library links open on (default US).
# Use ALL for every country.
# AD_LIBRARY_LINK_COUNTRY=US

# Brand website checks are on by default (they fetch public pages and honor robots.txt).
# Set to "false" to disable outbound fetches to brand sites.
# BRAND_WEBSITE_FETCH=true
